---
type Props = {
  asset?: string;
  platform?: string;
  side?: "LONG" | "SHORT";
  risk?: string;
  entry?: number;
  fill?: number;
  stop?: number;
  target?: number;
  date: Date;
};

const { asset, platform, side, risk, entry, fill, stop, target, date } = Astro.props;

// Reward:risk measured from the actual fill when there is one.
const anchor = fill ?? entry;
const rr =
  anchor !== undefined && stop !== undefined && target !== undefined && anchor !== stop
    ? (Math.abs(target - anchor) / Math.abs(stop - anchor)).toFixed(2)
    : undefined;

const opened = date.toLocaleString("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
});

const cell = "flex flex-col gap-0.5";
const label = "font-mono text-[0.65rem] uppercase tracking-widest text-black/50 dark:text-white/50";
const value = "text-sm font-semibold text-black dark:text-white";
---

<dl
  class="not-prose flex flex-wrap gap-x-8 gap-y-4 rounded-lg border border-black/15 px-4 py-3 dark:border-white/20"
>
  {asset && (
    <div class={cell}>
      <dt class={label}>Asset</dt>
      <dd class={`${value} font-mono`}>{asset}</dd>
    </div>
  )}
  {side && (
    <div class={cell}>
      <dt class={label}>Side</dt>
      <dd>
        <span
          class:list={[
            "rounded-sm px-1.5 py-0.5 font-mono text-xs font-semibold text-white",
            side === "LONG" ? "bg-emerald-600" : "bg-rose-600",
          ]}
        >
          {side}
        </span>
      </dd>
    </div>
  )}
  {platform && (
    <div class={cell}>
      <dt class={label}>Platform</dt>
      <dd class={value}>{platform}</dd>
    </div>
  )}
  {risk && (
    <div class={cell}>
      <dt class={label}>Risk</dt>
      <dd class={value}>{risk}</dd>
    </div>
  )}
  {entry !== undefined && (
    <div class={cell}>
      <dt class={label}>Entry</dt>
      <dd class={`${value} font-mono`}>
        {fill !== undefined && fill !== entry ? (
          <>
            {fill} <span class="font-normal text-black/50 dark:text-white/50">(planned {entry})</span>
          </>
        ) : (
          entry
        )}
      </dd>
    </div>
  )}
  {stop !== undefined && (
    <div class={cell}>
      <dt class={label}>Stop</dt>
      <dd class={`${value} font-mono text-rose-600 dark:text-rose-400`}>{stop}</dd>
    </div>
  )}
  {target !== undefined && (
    <div class={cell}>
      <dt class={label}>Target</dt>
      <dd class={`${value} font-mono text-emerald-600 dark:text-emerald-400`}>{target}</dd>
    </div>
  )}
  {rr && (
    <div class={cell}>
      <dt class={label}>R:R</dt>
      <dd class={`${value} font-mono`}>{rr}</dd>
    </div>
  )}
  <div class={cell}>
    <dt class={label}>Opened</dt>
    <dd class={value}><time datetime={date.toISOString()}>{opened}</time></dd>
  </div>
</dl>
